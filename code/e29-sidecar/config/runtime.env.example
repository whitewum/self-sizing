# Copy to runtime.env and replace every angle-bracket placeholder locally.
# Never commit runtime.env because JDBC URLs can contain plaintext credentials.

E29_ORACLE_USER=<oracle_user>
E29_ORACLE_PASSWORD=<oracle_password>
E29_ORACLE_SERVICE=<oracle_service_name>
E29_ORACLE_JDBC_URL='jdbc:oracle:thin:<user>/<password>@//<oracle_host>:1521/<service>'

E29_MYSQL_USER=<mysql_user>
E29_MYSQL_PASSWORD=<mysql_password>
E29_MYSQL_DATABASE=<mysql_db>
E29_MYSQL_JDBC_URL='jdbc:mysql://<user>:<password>@<mysql_host>:3306/<db>?useSSL=false&allowPublicKeyRetrieval=true'

E29_SOURCE_API=http://127.0.0.1:19090
E29_TARGET_API=http://127.0.0.1:19091
E29_PLACEHOLDER_TABLE=items
