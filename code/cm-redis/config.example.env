# Copy to config.env and edit. This file is sourced by Bash; quote values containing shell syntax.
#
# Run start-sidecar.sh a on a machine that can reach Redis A.
# Run start-sidecar.sh b on a machine that can reach Redis B.

A_REDIS_HOST=127.0.0.1
A_REDIS_PORT=6379
A_REDIS_DB=0
A_REDIS_PASSWORD=
A_REDIS_SCAN_COUNT=1000
A_SIDECAR_BIND=127.0.0.1
A_SIDECAR_PORT=9090

B_REDIS_HOST=127.0.0.1
B_REDIS_PORT=6379
B_REDIS_DB=0
B_REDIS_PASSWORD=
B_REDIS_SCAN_COUNT=1000
B_SIDECAR_BIND=127.0.0.1
B_SIDECAR_PORT=9091

# URLs reachable from the machine running compare-existing.sh.
A_SIDECAR_URL=http://127.0.0.1:9090
B_SIDECAR_URL=http://127.0.0.1:9091

# Optional. Relative paths are resolved from the kit root.
CLASS_DIR=build/classes
RUN_DIR=run
MERKLE_BUCKETS=128
# Redis Merkle materializes its first scan here so dirty-bucket drill never rescans Redis.
# Defaults to FP_STORE_DIR (run/sidecar-<role>/fingerprint-cache under start-sidecar.sh).
MERKLE_CACHE_SHARDS=64
MERKLE_CACHE_BUF_MB=16
VALUE_SAMPLE_LIMIT=0
